[resource]
code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_lambert, specular_schlick_ggx;

uniform vec2 VelocidadeEnergia = vec2(0.000000, 1.000000);
uniform int DensidadeEnergia = 5;
uniform float CoresVelocidade = 1;
uniform vec2 OffsetXY = vec2(0.000000, 0.000000);
uniform vec2 EscalaXY = vec2(1.000000, 1.000000);
uniform sampler2D TexturaCircuito : repeat_enable;
uniform sampler2D FundoPadrao : source_color;
uniform vec2 NormalMapOffset;
uniform vec2 NormalMapEscale;
uniform sampler2D tex_frg_61;


// Voronoi
#include \"res://addons/ShaderLib/Procedural/Procedural.gdshaderinc\"

void fragment() {
// Input:26
	float n_out26p0 = TIME;


// Vector2Parameter:31
	vec2 n_out31p0 = VelocidadeEnergia;


// VectorOp:27
	vec2 n_out27p0 = vec2(n_out26p0) * n_out31p0;


// UVFunc:28
	vec2 n_in28p1 = vec2(1.00000, 1.00000);
	vec2 n_out28p0 = n_out27p0 * n_in28p1 + UV;


// IntParameter:33
	int n_out33p0 = DensidadeEnergia;


	float n_out23p0;
	float n_out23p1;
// Voronoi:23
	float n_in23p2 = 2.00000;
	{
		voronoi_noise(n_out28p0, float(n_out33p0), n_in23p2, 1, 0., n_out23p0, n_out23p1);
	}


// Input:36
	float n_out36p0 = TIME;


// FloatParameter:60
	float n_out60p0 = CoresVelocidade;


// FloatOp:59
	float n_out59p0 = n_out36p0 * n_out60p0;


// FloatOp:58
	float n_out58p0 = n_out59p0 + n_out60p0;


// FloatFunc:52
	float n_out52p0 = sin(n_out58p0);


// FloatOp:55
	float n_in55p1 = 5.00000;
	float n_out55p0 = n_out52p0 * n_in55p1;


// FloatFunc:53
	float n_out53p0 = cos(n_out59p0);


// FloatOp:56
	float n_in56p1 = 5.00000;
	float n_out56p0 = n_out53p0 * n_in56p1;


// FloatFunc:54
	float n_out54p0 = sin(n_out59p0);


// FloatOp:57
	float n_in57p1 = 5.00000;
	float n_out57p0 = n_out54p0 * n_in57p1;


// VectorCompose:51
	vec3 n_out51p0 = vec3(n_out55p0, n_out56p0, n_out57p0);


// VectorOp:35
	vec3 n_out35p0 = vec3(n_out23p0) * n_out51p0;


// Vector2Parameter:17
	vec2 n_out17p0 = OffsetXY;


// UVFunc:16
	vec2 n_in16p1 = vec2(1.00000, 1.00000);
	vec2 n_out16p0 = n_out17p0 * n_in16p1 + UV;


// Vector2Parameter:15
	vec2 n_out15p0 = EscalaXY;


// UVFunc:11
	vec2 n_in11p2 = vec2(0.00000, 0.00000);
	vec2 n_out11p0 = (n_out16p0 - n_in11p2) * n_out15p0 + n_in11p2;


	vec4 n_out5p0;
// Texture2D:5
	n_out5p0 = texture(TexturaCircuito, n_out11p0);


// Mix:30
	vec3 n_in30p0 = vec3(0.00000, 0.00000, 0.00000);
	vec3 n_out30p0 = mix(n_in30p0, n_out35p0, vec3(n_out5p0.xyz));


	vec4 n_out20p0;
// Texture2D:20
	n_out20p0 = texture(FundoPadrao, UV);


// ColorOp:22
	vec3 n_out22p0 = max(vec3(n_out5p0.xyz), vec3(n_out20p0.xyz));


// VectorOp:34
	vec3 n_out34p0 = n_out30p0 + n_out22p0;


// Input:62
	vec2 n_out62p0 = UV;


// Vector2Parameter:64
	vec2 n_out64p0 = NormalMapOffset;


// UVFunc:63
	vec2 n_in63p1 = vec2(1.00000, 1.00000);
	vec2 n_out63p0 = n_out64p0 * n_in63p1 + n_out62p0;


// Vector2Parameter:66
	vec2 n_out66p0 = NormalMapEscale;


// UVFunc:65
	vec2 n_in65p2 = vec2(0.00000, 0.00000);
	vec2 n_out65p0 = (n_out63p0 - n_in65p2) * n_out66p0 + n_in65p2;


// Texture2D:61
	vec4 n_out61p0 = texture(tex_frg_61, n_out65p0);


// Output:0
	ALBEDO = n_out34p0;
	NORMAL_MAP = vec3(n_out61p0.xyz);


}
