code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_lambert, specular_schlick_ggx;

uniform float Velocidade = 1;
uniform float Tamanho;
uniform sampler2D tex_frg_43;
uniform vec4 ColorParameter : source_color = vec4(1.000000, 1.000000, 1.000000, 1.000000);
uniform float FloatParameter;
uniform sampler2D tex_frg_51 : source_color;
uniform sampler2D tex_frg_52;
uniform sampler2D tex_frg_53;
uniform vec2 Vector2Parameter;



void fragment() {
// Input:32
	float n_out32p0 = TIME;


// FloatParameter:35
	float n_out35p0 = Velocidade;


// FloatOp:33
	float n_out33p0 = n_out32p0 * n_out35p0;


// FloatFunc:34
	float n_out34p0 = fract(n_out33p0);


// FloatParameter:38
	float n_out38p0 = Tamanho;


// FloatOp:37
	float n_out37p0 = n_out34p0 - n_out38p0;


// FloatOp:36
	float n_out36p0 = n_out34p0 + n_out38p0;


// Input:2
	vec2 n_out2p0 = UV;


// Vector2Constant:40
	vec2 n_out40p0 = vec2(0.500000, 0.500000);


// Distance:3
	float n_out3p0 = distance(n_out2p0, n_out40p0);


// SmoothStep:39
	vec2 n_out39p0 = smoothstep(vec2(n_out37p0), vec2(n_out36p0), vec2(n_out3p0));


// VectorFunc:41
	vec2 n_out41p0 = vec2(1.0) - n_out39p0;


// VectorOp:42
	vec2 n_out42p0 = n_out41p0 * n_out39p0;


// Texture2D:43
	vec4 n_out43p0 = texture(tex_frg_43, UV);


// FloatOp:44
	float n_out44p0 = n_out42p0.x * n_out43p0.x;


// ColorParameter:46
	vec4 n_out46p0 = ColorParameter;


// VectorOp:47
	vec3 n_out47p0 = atan(vec3(n_out44p0), vec3(n_out46p0.xyz));


	vec3 n_out49p0;
// If:49
	float n_in49p1 = 0.00000;
	float n_in49p2 = 0.00001;
	vec3 n_in49p3 = vec3(0.00000, 0.00000, 0.00000);
	vec3 n_in49p5 = vec3(0.00000, 0.00000, 0.00000);
	if(abs(n_out47p0.x - n_in49p1) < n_in49p2)
	{
		n_out49p0 = n_in49p3;
	}
	else if(n_out47p0.x < n_in49p1)
	{
		n_out49p0 = n_in49p5;
	}
	else
	{
		n_out49p0 = n_out47p0;
	}


// FloatParameter:57
	float n_out57p0 = FloatParameter;


// UVFunc:56
	vec2 n_in56p2 = vec2(0.00000, 0.00000);
	vec2 n_out56p0 = (UV - n_in56p2) * vec2(n_out57p0) + n_in56p2;


// Texture2D:51
	vec4 n_out51p0 = texture(tex_frg_51, n_out56p0);


// ColorOp:50
	vec3 n_out50p0 = max(n_out49p0, vec3(n_out51p0.xyz));


// Texture2D:52
	vec4 n_out52p0 = texture(tex_frg_52, UV);


// Texture2D:53
	vec4 n_out53p0 = texture(tex_frg_53, UV);


// Vector2Parameter:55
	vec2 n_out55p0 = Vector2Parameter;


// FloatOp:54
	float n_out54p0 = n_out53p0.x * n_out55p0.x;


// Output:0
	ALBEDO = n_out50p0;
	METALLIC = n_out52p0.x;
	EMISSION = n_out50p0;
	NORMAL = vec3(n_out54p0);


}
