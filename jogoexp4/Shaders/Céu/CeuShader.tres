code = "shader_type sky;
uniform float Horizonte = 0;
uniform float Curvatura = 1;
uniform float MapeamentoQuadrados2 = 5;
uniform float Pulsacao = 1;
uniform sampler2D tex_sky_58;
uniform float VelocidadeTrocaNumeros = 0.25;
uniform float Densiade_de_mudana = 5;
uniform sampler2D tex_sky_59;


// GradientNoise
#include \"res://addons/ShaderLib/Procedural/Procedural.gdshaderinc\"

void sky() {
// FloatParameter:36
	float n_out36p0 = Horizonte;


// Input:34
	vec3 n_out34p0 = EYEDIR;
	float n_out34p2 = n_out34p0.g;


// FloatFunc:35
	float n_out35p0 = abs(n_out34p2);


// SmoothStep:33
	float n_in33p1 = 1.00000;
	float n_out33p0 = smoothstep(n_out36p0, n_in33p1, n_out35p0);


// Input:26
	vec3 n_out26p0 = EYEDIR;
	float n_out26p2 = n_out26p0.g;
	float n_out26p3 = n_out26p0.b;


// VectorCompose:27
	vec2 n_out27p0 = vec2(n_out26p3, n_out26p2);


// Input:21
	vec3 n_out21p0 = EYEDIR;
	float n_out21p2 = n_out21p0.g;


// FloatFunc:30
	float n_out30p0 = abs(n_out21p2);


// FloatParameter:32
	float n_out32p0 = Curvatura;


// FloatOp:31
	float n_out31p0 = pow(n_out30p0, n_out32p0);


// FloatOp:22
	float n_out22p0 = n_out27p0.x / n_out31p0;


// FloatParameter:23
	float n_out23p0 = MapeamentoQuadrados2;


// FloatOp:20
	float n_out20p0 = n_out22p0 * n_out23p0;


// FloatFunc:24
	float n_out24p0 = fract(n_out20p0);


// FloatOp:25
	float n_in25p1 = 0.50000;
	float n_out25p0 = n_out24p0 - n_in25p1;


// Input:2
	vec3 n_out2p0 = EYEDIR;
	float n_out2p1 = n_out2p0.r;
	float n_out2p2 = n_out2p0.g;


// VectorCompose:28
	vec2 n_out28p0 = vec2(n_out2p1, n_out2p2);


// FloatOp:17
	float n_out17p0 = n_out28p0.x / n_out31p0;


// FloatOp:5
	float n_out5p0 = n_out23p0 * n_out17p0;


// FloatFunc:4
	float n_out4p0 = fract(n_out5p0);


// FloatOp:19
	float n_in19p1 = 0.50000;
	float n_out19p0 = n_out4p0 - n_in19p1;


// VectorCompose:29
	float n_in29p2 = 0.00000;
	vec3 n_out29p0 = vec3(n_out25p0, n_out19p0, n_in29p2);


// FloatParameter:65
	float n_out65p0 = Pulsacao;


// Input:38
	float n_out38p0 = TIME;


// FloatFunc:63
	float n_out63p0 = sin(n_out38p0);


// FloatOp:64
	float n_out64p0 = n_out65p0 * n_out63p0;


// VectorOp:66
	vec2 n_out66p0 = vec2(n_out29p0.xy) + vec2(n_out64p0);


// Texture2D:58
	vec4 n_out58p0 = texture(tex_sky_58, n_out66p0);


// Input:52
	vec2 n_out52p0 = SKY_COORDS;


// VectorDecompose:44
	float n_out44p0 = vec3(n_out52p0, 0.0).x;
	float n_out44p1 = vec3(n_out52p0, 0.0).y;
	float n_out44p2 = vec3(n_out52p0, 0.0).z;


// FloatParameter:43
	float n_out43p0 = VelocidadeTrocaNumeros;


// FloatOp:42
	float n_out42p0 = n_out38p0 * n_out43p0;


// FloatFunc:68
	float n_out68p0 = floor(n_out42p0);


// FloatOp:45
	float n_out45p0 = n_out68p0 + n_out44p1;


// VectorCompose:46
	vec2 n_out46p0 = vec2(n_out44p0, n_out45p0);


// UVFunc:40
	vec2 n_in40p1 = vec2(1.00000, 1.00000);
	vec2 n_in40p2 = vec2(0.00000, 0.00000);
	vec2 n_out40p0 = n_in40p2 * n_in40p1 + n_out46p0;


// FloatParameter:60
	float n_out60p0 = Densiade_de_mudana;


	float n_out72p0;
// GradientNoise:72
	{
		n_out72p0 = gradient_noise(n_out40p0, n_out60p0);
	}


// Compare:49
	float n_in49p1 = 0.50000;
	bool n_out49p0 = n_out72p0 > n_in49p1;


// VectorOp:51
	vec3 n_out51p0 = vec3(n_out58p0.xyz) * vec3(n_out49p0 ? 1.0 : 0.0);


// Compare:53
	float n_in53p1 = 0.50000;
	bool n_out53p0 = n_out72p0 < n_in53p1;


// Texture2D:59
	vec4 n_out59p0 = texture(tex_sky_59, n_out66p0);


// VectorOp:55
	vec3 n_out55p0 = vec3(n_out53p0 ? 1.0 : 0.0) * vec3(n_out59p0.xyz);


// VectorOp:56
	vec3 n_out56p0 = n_out51p0 + n_out55p0;


// VectorOp:37
	vec3 n_out37p0 = vec3(n_out33p0) * n_out56p0;


// Output:0
	COLOR = n_out37p0;


}
